    for _,p in pairs(game.Players:GetPlayers()) do
        if p ~= v_lp then
            local f = Instance.new("Frame", sc); f.Size = UDim2.new(1,-5,0,35); f.BackgroundColor3 = Color3.fromRGB(35,35,40); Instance.new("UICorner", f)
            local t = Instance.new("TextLabel", f); t.Size = UDim2.new(1,-65,1,0); t.Text = p.Name; t.TextColor3 = Color3.new(1,1,1); t.BackgroundTransparency = 1; t.Font = "GothamBold"; t.TextScaled = true
            local b = Instance.new("TextButton", f); b.Size = UDim2.new(0,55,0,25); b.Position = UDim2.new(1,-58,0.5,-12); Instance.new("UICorner", b); b.TextColor3 = Color3.new(1,1,1); b.Font = "GothamBold"
            if mode == "TP" then 
                b.Text = "TP"; b.BackgroundColor3 = Color3.fromRGB(0,120,255)
                b.MouseButton1Click:Connect(function() 
                    -- TELEPORT SA LIKOD AT HINDI LUBOG
                    local target_hrp = p.Character.HumanoidRootPart
                    v_lp.Character.HumanoidRootPart.CFrame = target_hrp.CFrame * CFrame.new(0, 0, 3) -- 3 studs sa LIKOD
                end)
            else 
                b.Text = v_tracking[p.Name] and "ON" or "OFF"; b.BackgroundColor3 = v_tracking[p.Name] and Color3.new(0,0.6,0) or Color3.fromRGB(60,60,65)
                b.MouseButton1Click:Connect(function() v_tracking[p.Name] = not v_tracking[p.Name]; v_update_list(sc, mode) end) 
            end
        end
    end
end

