local ScriptFunctions = {}

-- [[ MODULE: COMBAT ]]
ScriptFunctions["Aimbot v2"] = function(s) print("Aimbot v2: ", s) end
ScriptFunctions["Silent Aim"] = function(s) print("Silent Aim: ", s) end
ScriptFunctions["Wallhack ESP"] = function(s) 
    local active = s
    spawn(function()
        while active do
            for _, p in pairs(game.Players:GetPlayers()) do
                if p ~= player and p.Character and not p.Character:FindFirstChild("Highlight") then
                    local h = Instance.new("Highlight", p.Character)
                    h.FillColor = Color3.new(1,0,0)
                end
            end
            wait(1)
        end
        for _, p in pairs(game.Players:GetPlayers()) do
            if p.Character and p.Character:FindFirstChild("Highlight") then p.Character.Highlight:Destroy() end
        end
    end)
end
ScriptFunctions["Hitbox Expander"] = function(s, v)
    local size = tonumber(v) or 20
    if s then
        for _, p in pairs(game.Players:GetPlayers()) do
            if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                p.Character.HumanoidRootPart.Size = Vector3.new(size, size, size)
                p.Character.HumanoidRootPart.Transparency = 0.7
            end
        end
    end
end

-- [[ MODULE: MOVEMENT ]]
ScriptFunctions["Speed Hack"] = function(s, v)
    player.Character.Humanoid.WalkSpeed = s and (tonumber(v) or 100) or 16
end
ScriptFunctions["Jump Hack"] = function(s, v)
    player.Character.Humanoid.JumpPower = s and (tonumber(v) or 150) or 50
end
ScriptFunctions["Fly Hack"] = function(s) print("Fly Active") end
ScriptFunctions["Infinite Jump"] = function(s)
    local conn
    if s then
        conn = game:GetService("UserInputService").JumpRequest:Connect(function()
            player.Character:FindFirstChildOfClass('Humanoid'):ChangeState("Jumping")
        end)
    else
        if conn then conn:Disconnect() end
    end
end

-- [[ MODULE: UTILITY ]]
ScriptFunctions["Infinite Yield"] = function(s) if s then loadstring(game:HttpGet('https://raw.githubusercontent.com/EdgeIY/infiniteyield/master/source'))() end end
ScriptFunctions["Full Bright"] = function(s) game.Lighting.Brightness = s and 2 or 1 end
ScriptFunctions["No Clip"] = function(s)
    game:GetService("RunService").Stepped:Connect(function()
        if s then
            for _, v in pairs(player.Character:GetDescendants()) do
                if v:IsA("BasePart") then v.CanCollide = false end
            end
        end
    end)
end

