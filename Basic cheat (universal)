-- [[ 🔐 AUTH SYSTEM ]]
local function startFactory()
    login:TweenPosition(UDim2.new(0.5, -130, 0, -250), "In", "Quad", 0.5)
    task.wait(0.6)
    main.Visible = true
end

loginBtn.MouseButton1Click:Connect(function()
    local s, res = pcall(function() return game:HttpGet(AUTH_LINK) end)
    if s and res:find(passInp.Text) and passInp.Text ~= "" then
        if writefile then writefile(SAVE_FILE, passInp.Text) end
        startFactory()
    else
        loginBtn.Text = "MALI ANG KEY"
        task.wait(1)
        loginBtn.Text = "LOGIN"
    end
end)

-- Auto-Login & Slide
task.spawn(function()
    task.wait(0.5)
    login:TweenPosition(UDim2.new(0.5, -130, 0.2, 0), "Out", "Back", 0.7)
    if isfile and isfile(SAVE_FILE) then
        local saved = readfile(SAVE_FILE)
        local s, res = pcall(function() return game:HttpGet(AUTH_LINK) end)
        if s and res:find(saved) then
            passInp.Text = saved
            startFactory()
        end
    end
end)
