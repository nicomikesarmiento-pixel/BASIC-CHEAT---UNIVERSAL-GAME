-- [[ 🧠 SYSTEM LOGIC ]]
local selected = {}
local cheats = {"Aimbot Head Lock", "ESP Chams Neon", "Silent Aim Pro", "Infinite Jump", "Fly Hack V3", "Speed Boost", "God Mode", "No Clip", "Kill Aura", "Auto Farm", "Invisible"}
for i = #cheats + 1, 110 do table.insert(cheats, "Mythic Script #" .. i) end

for _, name in pairs(cheats) do
    local b = Instance.new("TextButton", scroll)
    b.Text = "  " .. name .. " [SAFE]"
    b.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
    b.TextColor3 = Color3.new(0.7, 0.7, 0.7)
    b.Font = "Code"
    b.TextSize = 10
    b.TextXAlignment = "Left"
    Instance.new("UICorner", b)

    b.MouseButton1Click:Connect(function()
        if table.find(selected, name) then
            table.remove(selected, table.find(selected, name))
            b.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
        elseif #selected < 5 then
            table.insert(selected, name)
            b.BackgroundColor3 = Color3.fromRGB(0, 150, 180)
        end
        
        if #selected == 5 then
            genBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 150)
            genBtn.TextColor3 = Color3.new(1, 1, 1)
            genBtn.Text = "GENERATE CHEAT"
        else
            genBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
            genBtn.Text = "PILI PA NG " .. (5 - #selected)
        end
    end)
end

genBtn.MouseButton1Click:Connect(function()
    if #selected == 5 then
        genBtn.Text = "GENERATING..."
        task.wait(1.5)
        scriptText.Text = "loadstring(game:HttpGet('...'))(); -- NicoMythic: " .. table.concat(selected, ", ")
        genBtn.Text = "DONE!"
        task.wait(1)
        genBtn.Text = "GENERATE CHEAT"
    end
end)

copyBtn.MouseButton1Click:Connect(function()
    if setclipboard then
        setclipboard(scriptText.Text)
        copyBtn.Text = "OK"
        task.wait(1)
        copyBtn.Text = "COPY"
    end
end)

-- [[ 🔐 AUTH LOGIC ]]
local function startFactory()
    login.Visible = false
    main.Visible = true
end

loginBtn.MouseButton1Click:Connect(function()
    local s, r = pcall(function() return game:HttpGet(AUTH_LINK) end)
    if s and r:find(passInp.Text) and passInp.Text ~= "" then
        if writefile then writefile(SAVE_FILE, passInp.Text) end
        startFactory()
    else
        loginBtn.Text = "MALI KEY"
        task.wait(1)
        loginBtn.Text = "LOGIN"
    end
end)

task.spawn(function()
    if isfile and isfile(SAVE_FILE) then
        local saved = readfile(SAVE_FILE)
        local s, r = pcall(function() return game:HttpGet(AUTH_LINK) end)
        if s and r:find(saved) then
            passInp.Text = saved
            startFactory()
        end
    end
end)
