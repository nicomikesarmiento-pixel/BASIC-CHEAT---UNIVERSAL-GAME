-- [[ 🛠️ LOGIC ]]
local selected = {}
local cheatNames = {
    "Aimbot Head Lock [ANTI-BAN]", "ESP Chams Neon [SAFE]", "Silent Aim Pro", 
    "Infinite Jump Mobile", "Fly Hack V3", "Speed Boost Turbo", "God Mode Universal",
    "No Clip Alpha", "Kill Aura Reach", "Auto Farm Level", "Invisible Ghost"
}
for i = 12, 110 do table.insert(cheatNames, "Mythic Script #" .. i .. " [SAFE]") end

for _, name in pairs(cheatNames) do
    local b = Instance.new("TextButton", scroll)
    b.Size = UDim2.new(1, 0, 0, 30)
    b.Text = "  " .. name
    b.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    b.TextColor3 = Color3.new(0.7, 0.7, 0.7)
    b.Font = "Code"
    b.TextSize = 11
    b.TextXAlignment = "Left"
    Instance.new("UICorner", b)

    b.MouseButton1Click:Connect(function()
        if table.find(selected, name) then
            table.remove(selected, table.find(selected, name))
            b.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
            b.TextColor3 = Color3.new(0.7, 0.7, 0.7)
        elseif #selected < 5 then
            table.insert(selected, name)
            b.BackgroundColor3 = Color3.fromRGB(0, 150, 200)
            b.TextColor3 = Color3.new(1, 1, 1)
        end

        if #selected == 5 then
            genBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 150)
            genBtn.TextColor3 = Color3.new(1, 1, 1)
            genBtn.Text = "GENERATE CHEAT"
        else
            genBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
            genBtn.TextColor3 = Color3.fromRGB(100, 100, 100)
            genBtn.Text = "PILI PA NG " .. (5 - #selected)
        end
    end)
end

