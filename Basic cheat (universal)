-- [[ 🧠 AI LOGIC ]]
local lastCode = ""

local function generate()
    if #selectedCheats == 0 then info.Text = "Pumili ka muna ng kahit isa, Nico!" return end
    
    info.Text = "Gemini is weaving your mythic script... Please wait."
    genBtn.Text = "GENERATING..."
    
    local features = table.concat(selectedCheats, ", ")
    local gameName = game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId).Name
    
    local prompt = [[
        Create a high-level Roblox exploit script for "]] .. gameName .. [[".
        Features to include: ]] .. features .. [[.
        Requirement: Universal support, Anti-Ban protection, and smooth performance.
        Return ONLY JSON: {"explanation": "Taglish info", "code": "lua code"}
    ]]

    local success, result = pcall(function()
        return request({
            Url = API_URL,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode({ contents = {{ parts = {{ text = prompt }} }} })
        })
    end)

    if success and result.Success then
        local data = HttpService:JSONDecode(result.Body)
        local raw = data.candidates[1].content.parts[1].text:match("{.+}")
        local final = HttpService:JSONDecode(raw)
        
        lastCode = final.code
        scriptStatus.Text = "MYTHIC SCRIPT READY!"
        info.Text = "AI: " .. final.explanation
        
        -- Run it immediately too
        local f = loadstring(lastCode)
        if f then task.spawn(f) end
    else
        info.Text = "Connection error. Retry generate."
    end
    genBtn.Text = "GENERATE SCRIPT"
end

copyBtn.MouseButton1Click:Connect(function()
    if lastCode ~= "" and setclipboard then
        setclipboard(lastCode)
        copyBtn.Text = "COPIED!"
        task.wait(2)
        copyBtn.Text = "COPY CODE"
    end
end)

genBtn.MouseButton1Click:Connect(generate)
