-- [[ 🛡️ 1. ORIGINAL PROTECTION ]]
local v_mt = getrawmetatable(v_game)
local v_namecall = v_mt.__namecall
setreadonly(v_mt, false)
v_mt.__namecall = newcclosure(function(self, ...)
    local v_method = getnamecallmethod()
    if v_method == "FireServer" and (tostring(self):lower():find("check") or tostring(self):lower():find("ban") or tostring(self):lower():find("log") or tostring(self):lower():find("kick")) then
        return nil 
    end
    return v_namecall(self, ...)
end)
