-- [[ ⚡ 6. CORE HEARTBEAT (FIXED FLY & TP) ]]
v_run.Heartbeat:Connect(function()
    pcall(function()
        local char = v_lp.Character
        local hrp = char.HumanoidRootPart
        local hum = char.Humanoid
        
        -- AUTO LIFE
        if v_extra_lives > 0 and hum.Health <= 0 then
            v_extra_lives = v_extra_lives - 1; life_v.Text = tostring(v_extra_lives)
            local old_cf = hrp.CFrame; task.wait(0.1); v_lp:LoadCharacter(); task.wait(0.2); v_lp.Character.HumanoidRootPart.CFrame = old_cf
        end

        if v_speed and hum.MoveDirection.Magnitude > 0 then hrp.CFrame = hrp.CFrame + (hum.MoveDirection * 1.1) end
        if v_god then hum.MaxHealth, hum.Health = 9e9, 9e9 end
        if v_noclip then for _,v in pairs(char:GetDescendants()) do if v:IsA("BasePart") then v.CanCollide = false end end end

        -- FIXED FLY (MAKIKATAYO PAG OFF)
        if v_fly then
            local bv = hrp:FindFirstChild("FlyBV") or Instance.new("BodyVelocity", hrp); bv.Name = "FlyBV"
            local bg = hrp:FindFirstChild("FlyBG") or Instance.new("BodyGyro", hrp); bg.Name = "FlyBG"
            bv.MaxForce, bg.MaxTorque = Vector3.new(9e9,9e9,9e9), Vector3.new(9e9,9e9,9e9)
            hum.PlatformStand = true
            bv.Velocity = (hum.MoveDirection * 100) + Vector3.new(0, (v_up and 100 or 0) + (v_down and -100 or 0), 0)
            bg.CFrame = workspace.CurrentCamera.CFrame
        else
            if hrp:FindFirstChild("FlyBV") then hrp.FlyBV:Destroy() end
            if hrp:FindFirstChild("FlyBG") then hrp.FlyBG:Destroy() end
            hum.PlatformStand = false -- MAKIKATAYO NA DITO
        end

        for _, p in pairs(game.Players:GetPlayers()) do
            if p ~= v_lp and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local t_hrp = p.Character.HumanoidRootPart
                if v_big_hitbox then t_hrp.Size = Vector3.new(10,10,10); t_hrp.Transparency = 0.8 else t_hrp.Size = Vector3.new(2,2,1); t_hrp.Transparency = 1 end
                if v_chams then if not p.Character:FindFirstChild("NicoChams") then Instance.new("Highlight", p.Character).Name = "NicoChams" end else if p.Character:FindFirstChild("NicoChams") then p.Character.NicoChams:Destroy() end end
                local lN = p.Name.."_Line"
                if (v_esp_line or v_tracking[p.Name]) then local l = char:FindFirstChild(lN) or Instance.new("SelectionPartLasso", char); l.Name = lN; l.Part = t_hrp; l.Humanoid = hum; l.Color3 = v_tracking[p.Name] and Color3.new(1,1,0) or Color3.new(1,1,1) else if char:FindFirstChild(lN) then char[lN]:Destroy() end end
