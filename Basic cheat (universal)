-- [[ COMBAT ENGINE ]]
f["Aimbot v2"] = function(s)
    _G.Ab = s
    rs.RenderStepped:Connect(function()
        if _G.Ab then
            local t, d = nil, 2000
            for _, v in pairs(plrs:GetPlayers()) do
                if v ~= lp and v.Character and v.Character:FindFirstChild("Head") then
                    local p, vis = cam:WorldToViewportPoint(v.Character.Head.Position)
                    if vis then
                        local m = (Vector2.new(p.X, p.Y) - uis:GetMouseLocation()).Magnitude
                        if m < d then t = v; d = m end
                    end
                end
            end
            if t then cam.CFrame = CFrame.new(cam.CFrame.Position, t.Character.Head.Position) end
        end
    end)
end

f["Silent Aim"] = function(s)
    _G.Sa = s
    local old; old = hookmetamethod(game, "__index", function(self, idx)
        if _G.Sa and self:IsA("Mouse") and idx == "Hit" then
            local t, d = nil, 1000
            for _, v in pairs(plrs:GetPlayers()) do
                if v ~= lp and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
                    local p, vis = cam:WorldToViewportPoint(v.Character.HumanoidRootPart.Position)
                    if vis then local m = (Vector2.new(p.X, p.Y) - uis:GetMouseLocation()).Magnitude
                    if m < d then t = v; d = m end end
                end
            end
            return t and t.Character.HumanoidRootPart.CFrame or old(self, idx)
        end
        return old(self, idx)
    end)
end

f["Kill Aura"] = function(s)
    _G.Ka = s
    task.spawn(function()
        while _G.Ka do
            for _, v in pairs(plrs:GetPlayers()) do
                if v ~= lp and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
                    if (lp.Character.HumanoidRootPart.Position - v.Character.HumanoidRootPart.Position).Magnitude < 25 then
                        local tool = lp.Character:FindFirstChildOfClass("Tool")
                        if tool then tool:Activate() end
                    end
                end
            end
            task.wait(0.1)
        end
    end)
end

f["No Recoil"] = function(s)
    local old; old = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        if s and (method == "FireServer" or method == "InvokeServer") and (self.Name:find("Recoil") or self.Name:find("Shake")) then
            return nil
        end
        return old(self, ...)
    end)
end

