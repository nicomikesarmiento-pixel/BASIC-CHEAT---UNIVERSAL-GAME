-- [[ 🕒 3. LOADING SYSTEM ]]
local v_queue = {}
local v_is_run = false
local function v_process()
    if v_is_run or #v_queue == 0 then return end
    v_is_run = true
    while #v_queue > 0 do
        local v_act = table.remove(v_queue, 1)
        v_act.Callback(); task.wait(0.1)
    end
    v_is_run = false
end

