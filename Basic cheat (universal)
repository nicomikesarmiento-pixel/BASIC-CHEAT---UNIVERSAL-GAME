-- [[ 🧠 GEMINI AI INTEGRATION ]]
local function callGeminiAI(userQuery)
    local payload = HttpService:JSONEncode({
        contents = {{
            parts = {{ text = "Generate a Roblox script loadstring for these features: " .. userQuery .. ". Only return the loadstring line." }}
        }}
    })

    local success, response
    local delayTime = 1
    for i = 1, 5 do
        success, response = pcall(function()
            return game:HttpPost(apiUrl, payload, "application/json")
        end)
        if success then break end
        task.wait(delayTime)
        delayTime = delayTime * 2
    end

    if success then
        local data = HttpService:JSONDecode(response)
        local aiText = data.candidates[1].content.parts[1].text
        return aiText:gsub("\n", "")
    else
        return "Error calling AI. Please try again."
    end
end

