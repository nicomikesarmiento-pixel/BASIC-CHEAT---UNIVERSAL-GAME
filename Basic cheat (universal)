local f = shared.NicoLogic
local plrs = game:GetService("Players")
local lp = plrs.LocalPlayer

f["Aimbot v2"] = function(s)
    _G.Ab = s
    task.spawn(function()
        while _G.Ab do
            local target, dist = nil, 1000
            for _, v in pairs(plrs:GetPlayers()) do
                if v ~= lp and v.Character and v.Character:FindFirstChild("Head") then
                    local p, vis = workspace.CurrentCamera:WorldToViewportPoint(v.Character.Head.Position)
                    if vis then
                        local m = (Vector2.new(p.X, p.Y) - game:GetService("UserInputService"):GetMouseLocation()).Magnitude
                        if m < dist then dist = m; target = v end
                    end
                end
            end
            if target then workspace.CurrentCamera.CFrame = CFrame.new(workspace.CurrentCamera.CFrame.Position, target.Character.Head.Position) end
            task.wait()
        end
    end)
end

f["Kill Aura"] = function(s)
