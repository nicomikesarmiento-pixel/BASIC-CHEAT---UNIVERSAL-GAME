-- [[ 👁️ PART C: ROBLOX NATIVE HIGHLIGHT VISUALS ]]
local f = shared.NicoLogic
local plrs = game:GetService("Players")

-- FIXED CHAMS USING ROBLOX HIGHLIGHT OBJECT
f["Chams"] = function(s)
    _G.ChamsEnabled = s
    local function applyChams(char)
        if not char then return end
        if s then
            local h = char:FindFirstChild("NicoHighlight") or Instance.new("Highlight", char)
            h.Name = "NicoHighlight"
            h.FillColor = Color3.fromRGB(255, 0, 0)
            h.OutlineColor = Color3.fromRGB(255, 255, 255)
            h.FillAlpha = 0.5
            h.OutlineAlpha = 0
            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        else
            if char:FindFirstChild("NicoHighlight") then char.NicoHighlight:Destroy() end
        end
    end

    for _, v in pairs(plrs:GetPlayers()) do
        if v ~= plrs.LocalPlayer then applyChams(v.Character) end
    end

    plrs.PlayerAdded:Connect(function(p)
        p.CharacterAdded:Connect(function(c)
            task.wait(0.5)
            if _G.ChamsEnabled then applyChams(c) end
        end)
    end)
end

