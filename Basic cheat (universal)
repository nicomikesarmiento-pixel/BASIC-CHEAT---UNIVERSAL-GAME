local sg = Instance.new("ScreenGui", (gethui and gethui()) or core)
sg.Name = "NicoActiveDashboard"

local panel = Instance.new("Frame", sg)
panel.Size = UDim2.new(0, 220, 0, (#selectedCheats * 55) + 38)
panel.Position = UDim2.new(0.8, -230, 0.2, 0)
panel.BackgroundColor3 = Color3.fromRGB(10, 10, 15)
panel.Active = true
panel.Draggable = true
Instance.new("UICorner", panel).CornerRadius = UDim.new(0, 8)

local stroke = Instance.new("UIStroke", panel)
stroke.Thickness = 6 -- MAS MAKAPAL NA RAINBOW BORDER
stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

spawn(function()
    while task.wait() do
        local t = tick()
        stroke.Color = Color3.fromHSV(t % 3 / 3, 1, 1)
    end
end)

local layout = Instance.new("UIListLayout", panel)
layout.Padding = UDim.new(0, 5)
layout.HorizontalAlignment = Enum.HorizontalAlignment.Center

local title = Instance.new("TextLabel", panel)
title.Size = UDim2.new(1, 0, 0, 30)
title.Text = "NICO ACTIVE V23"
title.TextColor3 = Color3.new(1, 1, 1)
title.Font = Enum.Font.GothamBold
title.TextSize = 12
title.BackgroundTransparency = 1

for _, name in pairs(selectedCheats) do
    local row = Instance.new("Frame", panel)
    row.Size = UDim2.new(0.92, 0, 0, 50)
    row.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    Instance.new("UICorner", row)
    
    local label = Instance.new("TextLabel", row)
    label.Size = UDim2.new(1, 0, 0, 20)
    label.Text = name
    label.TextColor3 = Color3.fromRGB(0, 180, 255)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 10
    label.BackgroundTransparency = 1

    local toggle = Instance.new("TextButton", row)
    toggle.Size = UDim2.new(0.45, 0, 0, 24)
    toggle.Position = UDim2.new(0.03, 0, 0, 20)
    toggle.Text = "OFF"
    toggle.BackgroundColor3 = Color3.fromRGB(60, 0, 0)
    toggle.TextColor3 = Color3.new(1, 1, 1)
    toggle.Font = Enum.Font.GothamBold
    toggle.TextSize = 10
    Instance.new("UICorner", toggle)

    local active = false
    local inputField
    local isTarget = name:find("TP") or name:find("Fling")
    local isValue = name:find("Speed") or name:find("Jump") or name:find("Hitbox") or name:find("FOV") or name:find("Size")

    if isTarget or isValue then
        inputField = Instance.new("TextBox", row)
        inputField.Size = UDim2.new(0.45, 0, 0, 24)
        inputField.Position = UDim2.new(0.52, 0, 0, 20)
        inputField.PlaceholderText = isTarget and "Name" or "100"
        inputField.Text = isValue and "100" or ""
        inputField.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
        inputField.TextColor3 = Color3.new(1, 1, 1)
        Instance.new("UICorner", inputField)
    else
        toggle.Size = UDim2.new(0.94, 0, 0, 24)
    end

    toggle.MouseButton1Click:Connect(function()
        active = not active
        toggle.Text = active and "ON" or "OFF"
        toggle.BackgroundColor3 = active and Color3.fromRGB(0, 150, 70) or Color3.fromRGB(60, 0, 0)
        if ScriptFunctions[name] then
            task.spawn(function() ScriptFunctions[name](active, inputField and inputField.Text or "") end)
        end
    end)
end
