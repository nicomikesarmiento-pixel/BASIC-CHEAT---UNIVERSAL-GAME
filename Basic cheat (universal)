-- 53. Fly Hack (Velocity Based)
shared.NicoLogic["Fly Hack"] = function(state)
    local char = game.Players.LocalPlayer.Character
    if state then
        local bv = Instance.new("BodyVelocity", char.PrimaryPart)
        bv.Name = "NicoFly"
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Velocity = Vector3.new(0,0,0)
        task.spawn(function()
            while state and char:FindFirstChild("NicoFly") do
                bv.Velocity = workspace.CurrentCamera.CFrame.LookVector * 100
                task.wait()
            end
        end)
    else
        if char.PrimaryPart:FindFirstChild("NicoFly") then char.PrimaryPart.NicoFly:Destroy() end
    end
end

