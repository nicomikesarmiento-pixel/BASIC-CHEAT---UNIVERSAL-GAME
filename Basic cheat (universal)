-- [[ 🛠️ LOGIC & FUNCTIONALITY ]]
local selected = {}
local cheatNames = {"Aimbot Pro", "Silent Aim", "ESP Neon", "Fly Mode", "God Mode", "Kill Aura", "Speed X", "No Clip", "Inf Jump", "Auto Farm", "Invis", "Teleport"}
for i = 13, 115 do table.insert(cheatNames, "Mythic " .. i) end

for _, name in pairs(cheatNames) do
    local b = Instance.new("TextButton", scroll)
    b.Text = name .. "\n[ANTI-BAN]"
    b.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    b.TextColor3 = Color3.new(0.7, 0.7, 0.7)
    b.Font = "Code"
    b.TextSize = 9
    Instance.new("UICorner", b)

    b.MouseButton1Click:Connect(function()
        if table.find(selected, name) then
            table.remove(selected, table.find(selected, name))
            b.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
        elseif #selected < 5 then
            table.insert(selected, name)
            b.BackgroundColor3 = Color3.fromRGB(0, 150, 200)
        end

        if #selected == 5 then
            genBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 150)
            genBtn.TextColor3 = Color3.new(1, 1, 1)
            genBtn.Text = "GENERATE CHEAT"
        else
            genBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
            genBtn.TextColor3 = Color3.new(0.5, 0.5, 0.5)
            genBtn.Text = "PILI PA NG " .. (5 - #selected)
        end
    end)
end

